import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# Loading Excel file
file_path = '/mnt/data/arazi-ES.xlsx'
excel_data = pd.ExcelFile(file_path)

# Loading data from the first page
data = excel_data.parse('Sayfa1')

# Set the second row as column headers and remove the first two rows
data.columns = data.iloc[1]
data = data[2:]

# Clear column names
data.columns = data.columns.fillna('Unknown')

# Remove columns and rows that do not contain all values
data = data.dropna(axis=1, how='all')
data = data.dropna(axis=0, how='all')

# Convert to numeric values and determine the index
data_numeric = data.set_index('Unknown').apply(pd.to_numeric, errors='coerce')

# Heat map creation
plt.figure(figsize=(12, 8))
sns.heatmap(data_numeric, annot=True, fmt=".2f", cmap='viridis', linewidths=0.5)
plt.title('Isı Haritası Analizi')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()

# Displaying the heat map
plt.show()
